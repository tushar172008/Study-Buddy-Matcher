# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this in your local environment when Gemini features are enabled.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Railway backend URL when the frontend is deployed separately on Vercel.
VITE_API_URL="https://your-railway-backend.up.railway.app"

# FRONTEND_URL: Vercel frontend URL allowed to call the Railway backend.
FRONTEND_URL="https://your-vercel-project.vercel.app"

# DATABASE_URL: Required on Vercel for permanent users, matches, and chats.
DATABASE_URL="postgresql://postgres:URL_ENCODED_PASSWORD@db.your-project-ref.supabase.co:5432/postgres"

# SESSION_SECRET: Required in production for signing login sessions.
SESSION_SECRET="your_long_random_secret_here"

# GOOGLE_MAPS_API_KEY: Optional; required for campus map search and geocoding.
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
